@inproceedings{10.1007/978-3-032-35387-0_31,
author = {Kespechara, K. and Mingkhwan, A.},
title = {Multi-source Knowledge Graph RAG for&nbsp;LLM-Based Medical Diagnosis},
year = {2026},
isbn = {978-3-032-35386-3},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-3-032-35387-0_31},
doi = {10.1007/978-3-032-35387-0_31},
abstract = {Retrieval-Augmented Generation (RAG) grounds Large Language Model (LLM) outputs in external evidence, yet single-source retrieval leaves complementary diagnostic signals unexploited. This paper introduces a multi-source RAG framework that integrates dense vector retrieval, sparse lexical retrieval with Positive Pointwise Mutual Information (PPMI) statistics, and a heterogeneous knowledge graph combining ontological, co-occurrence, and statistical edges to support LLM-based differential diagnosis. The three retrieval modalities are fused via reciprocal rank fusion, providing the LLM with complementary evidence layers that mirror how clinicians consult textbooks, experience, and pattern recognition. On DDXPlus (49 diseases, n=1,000), the framework achieves 94.3% Top-1 accuracy with near-zero hallucination (≤0.3%), compared to 31.8% Top-1 and 62.1% hallucination for the unaugmented LLM. A reduced-leakage variant excluding ontological edges achieves 92.7% Top-1, a 1.6pp gap quantifying the contribution of dataset-specific knowledge. On Symptom2Disease (24 diseases, n=320), it achieves 90.3% Top-1 and 98.8% Top-5 with zero hallucination.},
booktitle = {Artificial Intelligence in Healthcare: Third International Conference, AIiH 2026, London, UK, August 26–28, 2026, Proceedings, Part I},
pages = {429–442},
numpages = {14},
keywords = {Retrieval-Augmented Generation, Knowledge Graph, Medical Diagnosis, Large Language Models, Hallucination Mitigation}
}

@inproceedings{10.1145/3833541.3833577,
author = {Wang, Yuze and Shi, Mingxiang and Qin, Xiulei and Yu, Le and Zhou, Shajun and Li, Changshuai},
title = {Research on question answering reasoning method of knowledge graph based on large language model and thinking chain},
year = {2026},
isbn = {9798400722646},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3833541.3833577},
doi = {10.1145/3833541.3833577},
abstract = {The knowledge graph question answering technology faces challenges such as path breakage, high rate of factual hallucinations and lack of explicability in complex multi hop reasoning tasks. Aiming at the problem of weak deep reasoning ability in the fusion process of large language model and knowledge graph, this paper proposes a hybrid reasoning framework guided by fusion thinking chain. The framework dynamically shunts the types of questions through the intention recognition module, uses the triplet vector retrieval strategy for simple questions to achieve fast and accurate answers, and uses the multi hop reasoning strategy driven by the thinking chain to construct an interpretable reasoning path for complex questions. Experiments on the three standard datasets of webqsp, cwq and cr-lt show that the proposed method is superior to the mainstream baseline model in accuracy, path rationality score and path integrity index. The reasoning accuracy of complex problems is improved by more than 15%, and the factual illusion rate is reduced to 4.8%. Ablation experiments verify the contribution of each module to the system performance. This method shows good application potential in knowledge intensive scenarios such as scientific and technological information decision-making, and provides an effective technical path for the construction of high reliability and traceability intelligent question answering system.},
booktitle = {Proceedings of the 2026 3rd International Conference on Digital Society and Artificial Intelligence},
pages = {204–210},
numpages = {7},
keywords = {Graph reasoning, Knowledge graph, Large language model, Question Answering, Thinking chain},
location = {Wuhan, China},
series = {DSAI '26}
}

@article{10.1016/j.eswa.2025.127430,
author = {Cui, Yachao and Wang, Kaiguang and Yu, Hongli and Guo, Xiaoxu and Cao, Han},
title = {KLLMs4Rec: Knowledge graph-enhanced LLMs sentiment extraction for personalized recommendations},
year = {2025},
issue_date = {Jul 2025},
publisher = {Pergamon Press, Inc.},
address = {USA},
volume = {282},
number = {C},
issn = {0957-4174},
url = {https://doi.org/10.1016/j.eswa.2025.127430},
