url = {https://doi.org/10.1145/3804601.3804680},
doi = {10.1145/3804601.3804680},
abstract = {Medical knowledge evolves rapidly and requires verifiable, time-aware evidence chains. Purely parametric LLMs fall short in explainability and timeliness for clinical-grade QA. We present Retrieval-LLM-Symbolic, a dynamic neuro- symbolic framework for medical QA. It combines dual channel retrieval (Text-RAG + Graph-RAG) for authoritative evidence aggregation, LLM-driven intermediate reasoning with temporal/causal tags, and a Symbolic Logic Layer that enforces rule-based verification and consistency. A background EvoKG module continuously evolves the medical knowledge graph with versioning and conflict resolution, replacing outdated facts on the fly. On MedQA (USMLE-style), MedQA-CS (clinical skills), and PubMedQA, our method outperforms strong baselines (static LLM, Text-RAG, Graph-RAG) by +6.8/ +7.5 / +15.2 in Accuracy/ Consistency-F1/ Explainability score, respectively; a 13B backbone rivals or surpasses 70B static models. Ablations show EvoKG's temporal index and conflict handling boost performance on time-sensitive queries (+9.1 accuracy), while symbolic verification reduces hallucinations by 37%. We release reproducible scripts and pseudo-code, offering a practical path toward trustworthy medical AI.},
booktitle = {Proceedings of the 5th International Conference on Computer, Artificial Intelligence and Control Engineering},
pages = {514–518},
numpages = {5},
keywords = {Dual-Channel Retrieval, EvoKG, Medical Question Answering, Retrieval-LLM-Symbolic, Symbolic Verification},
location = {Hangzhou, China},
series = {CAICE '26}
}

