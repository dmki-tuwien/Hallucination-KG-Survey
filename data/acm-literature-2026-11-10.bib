@inproceedings{10.1007/978-3-032-34374-1_3,
author = {Ali, Ushtar and Lynden, Steven and Matono, Akiyoshi and Amagasa, Toshiyuki},
title = {Knowledge Graph Adapter-Based Augmentation Testbed for&nbsp;Large Language Models},
year = {2026},
isbn = {978-3-032-34373-4},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-3-032-34374-1_3},
doi = {10.1007/978-3-032-34374-1_3},
abstract = {Large Language Models (LLMs) encode substantial factual knowledge but often hallucinate due to their static parametric memory. Knowledge Graphs (KGs) provide structured and continuously updated information that can complement the knowledge stored in LLMs. In this paper, we present a lightweight Wikidata-based KG adapter that injects structured knowledge into frozen LLM hidden states through a hook-based mechanism without modifying the base model parameters. We develop an end-to-end testbed that integrates Wikidata retrieval, KG encoding, and hidden-state injection for factual question answering. Experiments on WikiWebQuestions using LLaMA-3 8B and Mistral-7B show that KG injection improves factual grounding and reduces hallucinations. We further provide an empirical analysis of the impact of KG injection across queries, highlighting both its benefits and limitations for factual knowledge augmentation.},
booktitle = {Database and Expert Systems Applications: 37th International Conference, DEXA 2026, Graz, Austria, August 11–13, 2026, Proceedings, Part I},
pages = {37–42},
numpages = {6},
keywords = {Large Language Models, KG Adapter, Graph management and analytics, Knowledge Graph Integration}
}

@inproceedings{10.1145/3770855.3818882,
author = {Lyu, Tianwen and Zhuang, Xiang and Ding, Keyan and Cao, Xinzhe and Liang, Lei and Zhao, Wei and Chen, Huajun and Zhang, Qiang},
title = {Knowledge Graph-Enhanced Long-CoT for Complex Biomolecular Reasoning},
year = {2026},
isbn = {9798400722592},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3770855.3818882},
doi = {10.1145/3770855.3818882},
abstract = {Biomolecular scientific questions often require multi-step mechanistic reasoning over structured knowledge such as protein–protein interactions, pathways, and disease associations. While large language models (LLMs) can generate chain-of-thought (CoT) rationales, biomolecular CoT is frequently unreliable due to biologically implausible steps and long-horizon inconsistencies, and naive knowledge augmentation remains brittle on large, noisy knowledge graphs. We propose Bio-KCoT, a knowledge-augmented long-CoT framework that emphasizes principled use of structured knowledge. Bio-KCoT transforms knowledge graphs (KGs) into high-fidelity mechanistic reasoning trajectories. Instead of relying on naive shortest paths or direct KG prompting, Bio-KCoT adopts a generative paradigm that synthesizes mechanistic explanations anchored on KG entities and distills them into structured reasoning topologies. These curated chains serve as high-quality target trajectories during Supervised Fine-Tuning (SFT), enabling the model to learn structured mechanistic decomposition. Subsequently, to further enforce logical rigor, we apply Group Relative Policy Optimization (GRPO) with a KG-aligned process reward. This mechanism explicitly scores intermediate steps against the curated evidence, penalizing unsupported hops and reducing hallucinations even when the final answer is correct. To rigorously evaluate these capabilities, we construct BioMolKGQA, a benchmark with curated multi-hop evidence paths spanning diverse biomolecular QA pairs and reasoning depths. Extensive experiments on this dataset confirm that Bio-KCoT delivers substantial performance gains, enabling parameter-constrained models to rival the reasoning fidelity of significantly larger baselines. These results validate that KG-guided reasoning serves as a critical mechanism to compensate for parameter disparity, particularly in tasks requiring deep traversal of biological mechanisms.},
booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
pages = {11599–11610},
numpages = {12},
keywords = {knowledge-augmented reasoning, long chain-of-thought, knowledge graphs, biomolecular reasoning, biological discovery},
location = {Jeju Island, Republic of Korea},
series = {KDD '26}
}

@inproceedings{10.1145/3770855.3817824,
author = {Li, Yunfei and Liu, Chengfei and Zhou, Rui and Xu, Zhiyu and Zhang, Siyu and Wei, Jin},
title = {KGA-LM: Representation-Level Grounding for Conversational Search over Knowledge Graphs},
year = {2026},
isbn = {9798400722592},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3770855.3817824},
doi = {10.1145/3770855.3817824},
abstract = {Integrating structured knowledge graphs (KGs) with Large Language Models (LLMs) is essential for trustworthy, knowledge intensive conversational systems. However, existing Retrieval Augmented Generation (RAG) methods typically rely on a retrieval-as-context paradigm that linearizes structured subgraphs into unstructured prompt tokens. This approach not only flattens rich structural dependencies but also leads to context inflation and evidence attenuation in multi-turn dialogues.To address these limitations, we propose KGA-LM, a framework that integrates external knowledge via representation-level grounding. Rather than treating retrieved evidence as transient input artifacts, KGA-LM encodes compact multi-hop subgraphs using a Graph Transformer and fuses them into the LLM decoder through a compatibility-aware latent interface. This design aligns the heterogeneous latent spaces of the graph encoder and the LLM, while a dual-gated fusion mechanism dynamically regulates the influence of non-parametric graph evidence across turns.Experiments on multiple conversational benchmarks demonstrate that KGA-LM significantly improves factual accuracy and reduces hallucination compared to prompt-linearized baselines. Crucially, by decoupling knowledge injection from prompt length, our approach mitigates retrieval signal decay under long contexts, offering a superior trade-off between grounding quality and inference efficiency.},
booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
pages = {2873–2884},
numpages = {12},
keywords = {conversational search, retrieval-augmented generation, knowledge graphs, representation learning, large language models},
location = {Jeju Island, Republic of Korea},
series = {KDD '26}
}

@inproceedings{10.1145/3770855.3817820,
author = {Chan, Yu-Kai and Lien, Wen-Sheng and Yao, Dong-Ting and Ruan, Bo-Kai and Lin, Kwan-Yeung and Shuai, Hong-Han and Chiang, Meng-Fen},
title = {HyperPatch: Sequential Knowledge Editing Under n-ary Structural Drift},
year = {2026},
isbn = {9798400722592},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3770855.3817820},
doi = {10.1145/3770855.3817820},
abstract = {Large Language Models (LLMs) rely on Knowledge Editing (KE) to maintain temporal validity, yet real-world knowledge is inherently n-ary. We demonstrate that in non-stationary environments, sequential updates to complex relations induce Structural Drift, a phenomenon where the binary reification of n-ary events into triples fractures relational atomicity. This precipitates Structure-Conditioned Knowledge Transfer Failure (SKTF), a systematic mis-grounding of the retriever frequently misdiagnosed as parametric hallucination. To tackle this, we propose HyperPatch, a parameter-preserving framework that reformulates sequential KE as a stability problem over hypergraph manifolds. HyperPatch preserves event integrity through three phases: (i) Structural Prior Initialization, establishing a topology-aware embedding space via contrastive learning on a Hypergraph Neural Network (HGNN) to capture high-order correlations; (ii) Sequential Topology Editing, utilizing a dual-stage mechanism that employs SimHash-based Topological Alignment for rapid conflict resolution and Topological LoRA Adaptation to track drift without backbone retraining; and (iii) Structure-Conditioned Reasoning, which integrates globally consistent evidence from fused linguistic and structural manifolds. On the MQuAKE-CF and MQuAKE-T benchmarks, HyperPatch achieves relative gains in Hop-wise Accuracy (H-Acc) of 96.24% and 21.06% over the strongest baseline, respectively. Further ablations demonstrate superior reliability under continuous n-ary update streams, whereas the standard KG-based variant suffers H-Acc collapses of up to 88.3% due to structural misalignment. Our code is publicly available at https://github.com/Kevin20010912/HyperPatch.git.},
booktitle = {Proceedings of the 32nd ACM SIGKDD Conference on Knowledge Discovery and Data Mining V.2},
pages = {309–320},
numpages = {12},
keywords = {knowledge editing, hypergraph editing, n-ary relations, structural drift, retrieval-augmented generation},
location = {Jeju Island, Republic of Korea},
series = {KDD '26}
}

@inproceedings{10.1007/978-981-92-3417-2_47,
author = {Jiang, Yuhang and Fei, Qingjing and Chen, Jianwen},
title = {DyGraph: A Dynamic Priority-Aware Framework for Multi-Hop Reasoning Over Knowledge Graph with Large Language Model},
year = {2026},
isbn = {978-981-92-3416-5},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-92-3417-2_47},
doi = {10.1007/978-981-92-3417-2_47},
abstract = {Large Language Models (LLMs) suffer from factual hallucinations and knowledge obsolescence due to their static parametric memory, motivating the use of Knowledge Graphs (KGs) as structured external knowledge. However, existing LLM-KG methods for complex KGQA explore the graph without first modeling the question's logical structure, and lack principled strategies for deciding the exploration order, resulting in low search efficiency and poor traceability in multi-hop scenarios. We propose DyGraph, a dynamic priority-aware LLM-KG collaborative reasoning framework. DyGraph first parses questions into structured query graphs as reasoning skeletons, then uses a dynamic priority routing mechanism to select the most well-constrained and least-cost exploration direction at each iteration. Through topology-aware semantic grounding, variables are progressively mapped to KG entities, and answers are generated from fully grounded subgraphs. Experiments on CWQ and WebQSP show that DyGraph achieves state-of-the-art performance on CWQ and competitive results on WebQSP, while outperforming LLM-augmented graph reasoning baselines in efficiency. Ablation studies confirm each component’s contribution, and the framework produces complete factual provenance traces for interpretability.},
booktitle = {Advanced Intelligent Computing Technology and Applications: 22nd International Conference on Intelligent Computing, ICIC 2026, Toronto, ON, Canada, July 22–26, 2026, Proceedings, Part XXII},
pages = {552–563},
numpages = {12},
keywords = {large language model, knowledge graph, retrieval-augmented generation}
}

@inproceedings{10.1007/978-981-92-2856-0_44,
author = {Liu, Shuang and Qi, Qinggele and Wu, Xiaohong and Deng, Xinyang},
title = {Agent-on-Graph: An Autonomous Agent Framework for&nbsp;Multi-hop Reasoning over&nbsp;Knowledge Graph},
year = {2026},
isbn = {978-981-92-2855-3},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-92-2856-0_44},
doi = {10.1007/978-981-92-2856-0_44},
abstract = {Large language models (LLMs) exhibit strong reasoning capabilities but remain constrained by hallucinations, outdated knowledge, and limited interpretability. Incorporating knowledge graphs (KGs) can mitigate these issues by providing structured and reliable factual grounding. However, existing KG-based methods typically rely on predefined retrieval strategies or unidirectional path exploration, which restrict flexibility in multi-hop reasoning. To address these challenges, an autonomous agent framework for multi-hop reasoning over knoweldge graph is proposed, which is able to decompose complex queries into sub-goals and iteratively perform graph traversal, entity backtracking, and error correction within a closed think–act–observe loop. Furhermore, it introduces a global state container and persistent memory to maintain contextual consistency throughout long-horizon reasoning. Extensive experiments demonstrate that AoG outperforms existing baselines in multi-hop reasoning accuracy and is able to generate interpretable proofs in the form of verified, structured evidence traces. Our code is available at .},
booktitle = {Knowledge Science, Engineering and Management: 19th International Conference, KSEM 2026, Beijing, China, July 17–19, 2026, Proceedings, Part III},
pages = {617–628},
numpages = {12},
keywords = {Knowledge Graph Question Answering, Large Language Models, Autonomous Agents, Multi-hop Reasoning}
}

@inproceedings{10.1007/978-981-92-2759-4_39,
author = {Wan, Yixuan and Wen, Zhipeng},
title = {RelGraphQA: Relation-Driven KGQA with&nbsp;Schema-Indexed Grounding},
year = {2026},
isbn = {978-981-92-2758-7},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-92-2759-4_39},
doi = {10.1007/978-981-92-2759-4_39},
abstract = {Large Language Models (LLMs) excel at language understanding but often hallucinate under multi-hop reasoning and schema constraints. Knowledge graphs (KGs), with verifiable symbolic queries, can mitigate this issue. We present RelGraphQA, a training-free, relation-driven framework that anchors LLM generation to KG schema via thresholded FAISS matching and deterministic query synthesis. Natural-language relation mentions are grounded to schema-valid relation types using a lightweight FAISS IndexIVFFlat, retaining only high-similarity candidates. We also early infer head/answer types (and common operators) as structural guards for SPARQL/Cypher. A compact five-stages, four LLM calls pipeline performs (i) type/operator inference, (ii) relation grounding with thresholded schema matching, (iii) single-query synthesis, and (iv) faithful verbalization strictly from executed results. On MetaQA, WebQSP, CWQ, and GrailQA, RelGraphQA achieves competitive Hits@1 scores and demonstrates robust performance across varying threshold settings. Ablations and sensitivity studies confirm the benefit of schema-indexed relation filtering and structural guards. Our code is publicly available at .},
booktitle = {Knowledge Science, Engineering and Management: 19th International Conference, KSEM 2026, Beijing, China, July 17–19, 2026, Proceedings, Part I},
pages = {535–548},
numpages = {14},
keywords = {KGQA, Large Language Models, Relation Grounding, Schema-Constrained Reasoning, Query Generation}
}

@inproceedings{10.1007/978-981-92-2494-4_16,
author = {Li, Yuxuan and Wang, Xinzhi and Liu, Ruishen and Wang, Mingxuan and Luo, Xiangfeng},
title = {Re-KGR: Mitigating Factual Hallucinations via&nbsp;Hybrid Graph Reasoning and&nbsp;Semantic Refinement},
year = {2026},
isbn = {978-981-92-2493-7},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-92-2494-4_16},
doi = {10.1007/978-981-92-2494-4_16},
abstract = {Factual hallucination remains a primary obstacle to deploying LLMs in knowledge-critical fields. A promising mitigation strategy involves post-hoc text correction leveraging structured facts from reliable Knowledge Graphs (KGs). However, current approaches rely on simple triple matching, failing to capture entity ambiguity or contextual nuances. Furthermore, exclusive reliance on sparse structured KGs often limits knowledge coverage by neglecting rich unstructured sources. To address these limitations, we propose Re-KGR, a robust correction framework integrating external knowledge with hybrid graph neural networks. Firstly, we introduce an entity linking mechanism to map relations to a canonical base, generating semantically precise subgraphs to address ambiguity. Secondly, We construct reference subgraphs from external sources like Wikipedia. A hybrid GNN then combines R-GCN for intra-graph dependencies and RGAT for cross-graph matching to precisely localize hallucinations. Finally, fine-grained graph matching signals guide the LLM to autonomously revise the original responses.},
booktitle = {Machine Learning and Knowledge Engineering for Decision Making: The 17th International FLINS Conference on Fuzzy Logic for Intelligent Systems and The 21st International Conference on Intelligent Systems and Knowledge Engineering, FLINS-ISKE 2026, Sydney, NSW, Australia, July 15–19, 2026, Proceedings, Part IV},
pages = {291–305},
numpages = {15},
keywords = {Large Language Models, Factual Hallucination, Knowledge Graph, Graph Neural Networks, Response Retrofitting}
}

