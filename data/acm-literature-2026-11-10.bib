@inproceedings{10.1007/978-981-92-1947-6_7,
author = {Ho, Tri Khang and Luo, Linhao and Liu, Zihang and Wang, Haishuai and Chen, Ling},
title = {MedGLM: Unifying Graph Neural Networks and&nbsp;Large Language Models for&nbsp;Knowledge Graph-Grounded Healthcare Prediction},
year = {2026},
isbn = {978-981-92-1946-9},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-92-1947-6_7},
doi = {10.1007/978-981-92-1947-6_7},
abstract = {The use of Electronic Health Records (EHRs) for healthcare prediction has gained significant attention in clinical decision-support systems. While integrating Large Language Models (LLMs) into healthcare prediction offers new possibilities for clinical reasoning and decision support, these models have limited access to domain-specific medical knowledge and can generate hallucinated responses, undermining reliable medical reasoning. Medical knowledge graphs (KGs), which store extensive medical concepts, have been used to inject knowledge into LLMs. However, KGs are often large and complex, making it difficult for current KG+LLM methods to retrieve the most relevant information for specific patients to ensure accurate predictions. To address these challenges, we present MedGLM, an innovative framework that combines graph neural networks (GNNs) with LLMs for KG-grounded healthcare prediction. MedGLM first uses a GNN to predict potential candidates by reasoning over a large-scale medical KG. Based on these candidates, we extract and rank patient-specific evidence paths by leveraging community structures within the KG. Using these paths, MedGLM performs fine-grained LLM reasoning to generate reliable predictions along with interpretable rationales. Experiments on two publicly available clinical datasets show that MedGLM outperforms state-of-the-art methods, delivering superior performance and interpretability in tasks such as diagnostic prediction and drug recommendation.},
booktitle = {Data Science: Foundations and Applications: 30th Pacific-Asia Conference on Knowledge Discovery and Data Mining, PAKDD 2026, Hong Kong, China, June 9–12, 2026, Proceedings, Part II},
pages = {77–89},
numpages = {13},
keywords = {Large Language Models, Knowledge Graphs, Graph Neural Networks}
}

@inproceedings{10.1145/3774935.3803063,
author = {Coucourde, Giulia},
title = {Knowledge Graphs and Large Language Models for Continuous Adaptation in Lifelong Learning},
year = {2026},
isbn = {9798400723117},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774935.3803063},
doi = {10.1145/3774935.3803063},
abstract = {Large Language Models (LLMs) have significantly transformed human-machine interaction, enabling unseen performance in natural language generation. Their remarkable versatility allows them to adapt to a wide range of scenarios, exhibiting substantial flexibility across domains and communicative contexts, but several constraints still persist. Current models are trained on largely static corpora and encode knowledge in an implicit and distributed manner. As a result, they may generate hallucinations, reproduce societal biases, and struggle to maintain long-term coherence across interactions. In the context of user modeling, these flaws become particularly critical, limiting models’ capacity to support continuous user adaptation and long-term personalization. On the other hand, Knowledge Graphs (KGs) provide explicit, interpretable, and structured representations of domain knowledge but lack the flexibility and generative capabilities of LLMs. Recently, multiple studies have suggested strategies that mitigate the limits of LLMs through the use of KGs and vice versa. This study aims to investigate how LLMs and KGs can be synergistically integrated to enable dynamic and interpretable user overlay modeling for lifelong learning.},
booktitle = {Proceedings of the 34th ACM Conference on User Modeling, Adaptation and Personalization},
pages = {623–626},
numpages = {4},
keywords = {User Modeling, Personalization, Lifelong Learning, Knowledge Graphs, Large Language Models, Adaptive Systems},
location = {Gothenburg, Sweden},
series = {UMAP '26}
}

@inproceedings{10.1007/978-981-92-2885-0_7,
author = {Basheer, Nurul Anis Balqis Iqbal and Nordin, Sharifalillah and Abdul-Rahman, Shuzlina and Ali, Azliza Mohd and Mutalib, Sofianita and Kamarudin, Siti Nur Kamaliah},
title = {Hallucination Mitigation in Multilingual Large Language Models: A Review of Retrieval-Augmented Generation and Knowledge Graph Approaches},
year = {2026},
isbn = {978-981-92-2884-3},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-92-2885-0_7},
doi = {10.1007/978-981-92-2885-0_7},
abstract = {Large Language Models (LLMs) tend to suffer from hallucinations, especially in knowledge-intensive and multilingual environments where knowledge grounding is limited. The problem is further aggravated in low-resource languages and code-mixed languages because of data unavailability and poor cross-lingual alignment. This review paper discusses the existing methods of handling hallucinations using the integration of Retrieval-Augmented Generation (RAG) and Knowledge Graphs (KGs), focusing on language applications. The paper discusses the effectiveness and limitations of the existing methods, including static retrieval systems and English-biased knowledge sources. The paper also emphasizes the need for adaptive and multilingual systems that integrate knowledge grounding with dynamic retrieval to enhance factual grounding in various languages.},
booktitle = {Advances and Trends in Artificial Intelligence. Theory and Applications: 39th International Conference on Industrial, Engineering and Other Applications of Applied Intelligent Systems, IEA/AIE 2026, Kuala Lumpur, Malaysia, July 6–8, 2026, Proceedings, Part I},
pages = {77–88},
numpages = {12},
keywords = {Hallucination, Mitigation, Multilingual, Large Language Model}
}

@inproceedings{10.1145/3774905.3794656,
author = {Xie, Haihua and He, Miao},
title = {(wt) GC-DPG: Graph-Constrained Dual-Phase Generation for Safe and Verifiable Chinese Medical Question Answering},
year = {2026},
isbn = {9798400723087},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3774905.3794656},
doi = {10.1145/3774905.3794656},
abstract = {Large language models (LLMs) have shown strong performance on open-domain question answering, but their tendency to hallucinate unverifiable or unsafe medical content limits their applicability in clinical decision support and patient education. In contrast, high-quality medical knowledge graphs (KGs) encode curated relations between diseases, symptoms, drugs, examinations, and diet. We propose GC-DPG (Graph-Constrained Dual-Phase Generation), a two-phase framework that tightly couples an LLM with a disease-centric KG for Chinese medical QA. In the first phase, GC-DPG performs graph-based answer planning : given a user question and a disease KG, it constructs a structured, disease-specific Answer Plan that enumerates which KG facts are permissible for each detected intent (e.g., symptoms, checks, drugs). In the second phase, GC-DPG performs graph-constrained generation and consistency checking : it converts the Answer Plan into a constrained prompt that explicitly restricts the LLM to the planned entities, then applies a bidirectional graph--answer consistency checker to compute a support ratio and detect plan-violating hallucinations. We instantiate GC-DPG on a large Chinese Disease KG and evaluate it on a disease-centric QA dataset. Empirical results show that GC-DPG substantially improves entity-level precision and reduces hallucinations compared to strong KG-RAG and LLM-only baselines, indicating that explicit graph-based planning and guardrails are crucial for making LLM-based medical QA both accurate and verifiable.},
booktitle = {Companion Proceedings of the ACM Web Conference 2026},
pages = {607–616},
numpages = {10},
keywords = {large language models, medical question answering, knowledge graph, retrieval-augmented generation, hallucination detection},
location = {Dubai, United Arab Emirates},
series = {WWW Companion '26}
}

@inproceedings{10.1007/978-3-032-25156-5_25,
author = {Barla, Naga Sowjanya and de Berardinis, Jacopo},
title = {Competency Questions as Executable Plans: A&nbsp;Controlled RAG Architecture for&nbsp;Cultural Heritage Storytelling},
year = {2026},
isbn = {978-3-032-25155-8},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-3-032-25156-5_25},
doi = {10.1007/978-3-032-25156-5_25},
abstract = {The preservation of intangible cultural heritage is a critical challenge as collective memory fades over time. While Large Language Models (LLMs) offer a promising avenue for generating engaging narratives, their propensity for factual inaccuracies or “hallucinations” makes them unreliable for heritage applications where veracity is a central requirement. To address this, we propose a novel neuro-symbolic architecture grounded in Knowledge Graphs (KGs) that establishes a transparent “plan-retrieve-generate” workflow for story generation. A key novelty of our approach is the repurposing of competency questions (CQs) – traditionally design-time validation artifacts – into run-time executable narrative plans. This approach bridges the gap between high-level user personas and atomic knowledge retrieval, ensuring that generation is evidence-closed and fully auditable. We validate this architecture using a new resource: the Live Aid KG, a multimodal dataset aligning 1985 concert data with the Music Meta Ontology and linking to external multimedia assets. We present a systematic comparative evaluation of three distinct Retrieval-Augmented Generation (RAG) strategies over this graph: a purely symbolic KG-RAG, a text-enriched Hybrid-RAG, and a structure-aware Graph-RAG. Our experiments reveal a quantifiable trade-off between the factual precision of symbolic retrieval, the contextual richness of hybrid methods, and the narrative coherence of graph-based traversal. Our findings offer actionable insights for designing personalised and controllable storytelling systems.},
booktitle = {The Semantic Web: 23rd European Semantic Web Conference, ESWC 2026, Dubrovnik, Croatia, May 10–14, 2026, Proceedings, Part I},
pages = {476–499},
numpages = {24},
keywords = {Knowledge Graphs, Digital Storytelling, Retrieval-Augmented Generation, Cultural Heritage, Competency Questions}
}

