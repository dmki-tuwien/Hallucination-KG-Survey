@inproceedings{10.1007/978-981-92-2494-4_9,
author = {Wang, Mingxuan and Wang, Xinzhi and Liu, Ruishen and Li, Yuxuan and Luo, Xiangfeng},
title = {SPARQ: Graph-Structured Queries Drive GNN Retrieval for&nbsp;Knowledge Graph Question Answering},
year = {2026},
isbn = {978-981-92-2493-7},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-92-2494-4_9},
doi = {10.1007/978-981-92-2494-4_9},
abstract = {In knowledge graph question answering (KGQA), retrieval-augmented generation (RAG) is used to retrieve relevant facts from knowledge graph (KG) and incorporate them into the input context of large language models (LLMs), thereby reducing hallucinations and improving answer prediction. However, entity relationships embedded in continuous textual contexts often exhibit semantic ambiguity, which hinders the reliable retrieval of reasoning paths from the KG. We propose Structured Path-Augmented Reasoning driven by Graph-structured Queries (SPARQ), a framework that translates questions into graph-structured queries to guide graph neural networks (GNNs) in extracting reasoning paths from the KG. Specifically, our approach first identifies the topic entities and relations in the question and then leverages an LLM to help construct a graph-structured query. Next, the constructed graph-structured query guides the GNNs to search the KG and retrieve highly relevant reasoning paths. Finally, we convert the retrieved reasoning paths into multiple-choice prompts and feed them to the LLM for more accurate answer prediction. Experimental results show that SPARQ improves both the accuracy and efficiency of reasoning path retrieval and answer prediction.},
booktitle = {Machine Learning and Knowledge Engineering for Decision Making: The 17th International FLINS Conference on Fuzzy Logic for Intelligent Systems and The 21st International Conference on Intelligent Systems and Knowledge Engineering, FLINS-ISKE 2026, Sydney, NSW, Australia, July 15–19, 2026, Proceedings, Part IV},
pages = {137–150},
numpages = {14},
keywords = {Large Language Models, Graph-Structured Query, Graph Neural Networks, Retrieval-Augmented Generation, Knowledge Graph Question Answering}
}

@inproceedings{10.1145/3764924.3770900,
author = {Sen, Sumit and Chauhan, Lokendra},
title = {Framework for Disambiguating Indigenous Place Names and SDIs for Tribal Communities},
year = {2025},
isbn = {9798400721878},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3764924.3770900},
doi = {10.1145/3764924.3770900},
abstract = {Indigenous, historical, and alternate place names are often missing or inconsistently represented in mainstream geospatial datasets, limiting their use in Spatial Data Infrastructures (SDIs) and AI applications. We introduce GraphRAG, a hybrid framework that combines a Neo4j knowledge graph, LlamaIndex orchestrated retrieval, and a Mistral large language model to contextualize and disambiguate culturally significant place names. Unlike standard RAG, our approach integrates structured relationships including indigenous variants, historical aliases as well as authoritative external gazetteers (GeoNames, Nominatim) to improve multilingual and temporal coverage. Using a curated dataset of Santhal Parganas, we compare GraphRAG with a baseline RAG system across utility, effectiveness, compute cost, and complexity. Results show that GraphRAG produces more accurate and culturally sensitive answers to complex queries while mitigating hallucinations, though at higher computational cost. By bridging large language models with structured, community relevant data, GraphRAG offers a practical way to make SDIs more inclusive, trustworthy, and useful for Indigenous and tribal communities.},
booktitle = {Proceedings of the 1st ACM SIGSPATIAL International Workshop on Spatial Intelligence for Smart and Connected Communities},
pages = {76–83},
numpages = {8},
keywords = {place names, SDIs, LLMs, GraphRAG, multilingual},
location = {Minneapolis, MN, USA},
series = {SpatialConnect '25}
}

