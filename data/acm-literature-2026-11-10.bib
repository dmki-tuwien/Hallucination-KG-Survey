@inproceedings{10.1145/3816325.3843673,
author = {Gao, Ying and Song, Xiaolin and Wang, Yuying and Yang, Yanli},
title = {Design of a Generative Artificial Intelligence-Enabled Smart Learning Support Platform for Higher Vocational Nursing Students},
year = {2026},
isbn = {9798400724343},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3816325.3843673},
doi = {10.1145/3816325.3843673},
abstract = {Higher vocational nursing education requires accurate, personalized, and continuously adaptive learning support. This study proposes a Generative Artificial Intelligence-Enabled Smart Learning Support Platform (GAI-SLSP) that integrates a large language model, retrieval-augmented generation, a nursing knowledge graph, dynamic learner modeling, and adaptive resource recommendation. The platform retrieves verified nursing knowledge before response generation, constructs evidence-grounded prompts, and applies consistency verification to reduce hallucinations. Student behaviors, assessment results, learning preferences, and temporal features are encoded into dynamic learner profiles to support personalized learning paths and closed-loop feedback optimization. Experiments were conducted using multi-source nursing education data and compared the proposed method with an LLM without RAG, keyword-based RAG, dense-retrieval RAG, and knowledge-graph-enhanced RAG. At the optimal retrieval depth of K=8, GAI-SLSP achieved 0.901 answer accuracy, 0.889 recall, and 0.896 NDCG, while reducing the hallucination rate to 0.049. The results demonstrate improved reliability, ranking quality, and educational adaptability for vocational nursing learning scenarios.},
booktitle = {Proceedings of the 2026 2nd International Conference on Big Data and Intelligent Medicine},
pages = {501–505},
numpages = {5},
keywords = {Generative artificial intelligence, knowledge graph, nursing education, personalized learning, retrieval-augmented generation},
location = {Chongqing, China},
series = {BDIMed '26}
}

@inproceedings{10.1145/3819836.3819975,
author = {Cao, Jiqing and Zhao, Xiaoyu},
title = {Construction method of knowledge enhanced industrial-LLM for intelligent manufacturing operation and maintenance},
year = {2026},
isbn = {9798400722066},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3819836.3819975},
doi = {10.1145/3819836.3819975},
abstract = {In response to the limitations of general retrieval-augmented generation (RAG) methods in handling term ambiguity and multi-hop causal reasoning in industrial scenarios, this paper proposes a knowledge-enhanced industrial large language model construction method for intelligent manufacturing operation and maintenance. It integrates knowledge graph entity alignment with RAG to enable dynamic knowledge recall, and employs low-rank adaptation for efficient fine-tuning using multi-source heterogeneous operation and maintenance data. The method also incorporates a constraint decoding mechanism based on real-time knowledge graph verification to suppress hallucinations and ensure output interpretability. Experimental results demonstrate significant improvements in fault diagnosis accuracy and maintenance plan generation quality compared to baseline models.},
booktitle = {Proceedings of the 2026 5th International Conference on Cyber Security, Artificial Intelligence and Digital Economy},
pages = {932–937},
numpages = {6},
keywords = {Industrial-LLM, Intelligent manufacturing operation and maintenance, Knowledge graph, Low rank adaptation, Search enhanced generation},
location = {Salamanca, Spain},
series = {CSAIDE '26}
}

@article{10.1007/s00530-026-02470-z,
author = {Deng, Xinyan and Xu, Yinxin and Zheng, Xiaorou and Dong, Shoubin},
title = {A knowledge enhanced framework for interpretable medical visual question and answering via large foundation model},
year = {2026},
issue_date = {Jul 2026},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
volume = {32},
number = {6},
issn = {0942-4962},
url = {https://doi.org/10.1007/s00530-026-02470-z},
doi = {10.1007/s00530-026-02470-z},
abstract = {Medical visual question answering (MVQA) plays a vital role in understanding medical images. However, although foundation models including large language model (LLM) and multimodal model trained on extensive medical datasets have achieved remarkable results in MVQA, they still face significant challenges in multimodal fusion, hallucination problems, and interpretability. To address these issues, we propose KEVQA, a framework for enhancing medical knowledge that integrates foundation model. This framework significantly improves text feature representation by deeply fusing knowledge graph (KG) with multimodal model and language model, and enhances the interpretability of the reasoning process by leveraging path information from KG. Specifically, KEVQA combines KG with multimodal model to strengthen text feature representation and provide interpretability through path information in KG. Moreover, we introduce a knowledge-enhanced prompt engineering method that utilizes structured information from KG to fill knowledge gaps in LLM, enabling effective integration of KG and LLM, and mitigating hallucination phenomena. Experimental results from the VQA-RAD, SLAKE, and PMC-VQA datasets indicate that KEVQA effectively leverages structured knowledge for visual reasoning while greatly improving the reasoning process’s interpretability.},
journal = {Multimedia Syst.},
month = jul,
numpages = {15},
keywords = {Medical visual question answering, Knowledge graph, Pretrained multimodal model, Large language model}
}

@inproceedings{10.1007/978-981-95-6426-2_46,
author = {Yang, Mengzheng and Ren, Yanfei and Opoku, David Osei and Li, Ruochang and Ren, Peng and Xing, Chunxiao},
title = {DSRAG: A Domain-Specific Retrieval Framework Based on&nbsp;Document-Derived Multimodal Knowledge Graph},
year = {2025},
isbn = {978-981-95-6425-5},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-981-95-6426-2_46},
doi = {10.1007/978-981-95-6426-2_46},
abstract = {Current general-purpose large language models (LLMs) commonly exhibit knowledge hallucination and insufficient domain-specific adaptability in domain-specific tasks, limiting their effectiveness in specialized question answering scenarios. Retrieval-augmented generation (RAG) effectively tackles these challenges by integrating external knowledge to enhance accuracy and relevance. However, traditional RAG still faces limitations in domain knowledge accuracy and context modeling. To enhance domain-specific question answering performance, this work focuses on a graph-based RAG framework, emphasizing the critical role of knowledge graph quality during the generation process. We propose DSRAG (Domain-Specific RAG), a multimodal knowledge graph-driven retrieval-augmented generation framework designed for domain-specific applications. Our approach leverages domain-specific documents as the primary knowledge source, integrating heterogeneous information such as text, images, and tables to construct a multimodal knowledge graph covering both conceptual and instance layers. Building on this foundation, we introduce semantic pruning and structured subgraph retrieval mechanisms, combining knowledge graph context and vector retrieval results to guide the language model towards producing more reliable responses. Evaluations using the Langfuse multidimensional scoring mechanism show that our method excels in domain-specific question answering, validating the efficacy of integrating multimodal knowledge graphs with retrieval-augmented generation.},
booktitle = {Web Information Systems and Applications: 22nd International Conference, WISA 2025, Xi’an, China, October 1, 2025, Proceedings},
pages = {523–530},
numpages = {8},
keywords = {Retrieval-augmented generation, Knowledge graph, Large language model}
}

