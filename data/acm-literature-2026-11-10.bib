@inproceedings{10.1007/978-3-031-72344-5_17,
author = {Li, Yihao and Zhang, Ru and Liu, Jianyi},
title = {An Enhanced Prompt-Based LLM Reasoning Scheme via&nbsp;Knowledge Graph-Integrated Collaboration},
year = {2024},
isbn = {978-3-031-72343-8},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-3-031-72344-5_17},
doi = {10.1007/978-3-031-72344-5_17},
abstract = {While Large Language Models (LLMs) demonstrate exceptional performance in a multitude of Natural Language Processing (NLP) tasks, they encounter challenges in practical applications, including issues with hallucinations, inadequate knowledge updating, and limited transparency in the reasoning process. To overcome these limitations, this study innovatively proposes a collaborative training-free reasoning scheme involving tight cooperation between Knowledge Graph (KG) and LLMs. This scheme first involves using LLMs to iteratively explore KG, selectively retrieving a task-relevant knowledge subgraph to support reasoning. The LLMs are then guided to further combine inherent implicit knowledge to reason on the subgraph while explicitly elucidating the reasoning process. Through such a cooperative approach, our scheme achieves more reliable knowledge-based reasoning and facilitates the tracing of the reasoning results. Experimental results show that our scheme significantly progressed across multiple datasets, notably achieving an improvement of over 10% on the QALD10 dataset compared to both the best baseline and the fine-tuned state-of-the-art (SOTA) models.},
booktitle = {Artificial Neural Networks and Machine Learning – ICANN 2024: 33rd International Conference on Artificial Neural Networks, Lugano, Switzerland, September 17–20, 2024, Proceedings, Part V},
pages = {251–265},
numpages = {15},
keywords = {Large Language Models, Knowledge Graph, Collaborative reasoning, Prompt-based}
}

@inproceedings{10.1145/3789982.3790002,
author = {Ganar, Rashmi and Dharme, Om A and Gharat, Smit A and Yadav, Anushka A and Parab, Arya A and Radke, Mansi A},
title = {LLM-based Enhanced Question Answering System in Medical Domain},
year = {2026},
isbn = {9798400718892},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3789982.3790002},
doi = {10.1145/3789982.3790002},
abstract = {Large Language Models (LLMs) represent a major advancement in the field of natural language processing, capable of understanding, generating and interacting with human language at a near-human level. LLMs show strong potential in medical QA, information retrieval and predictive analysis. In contrast to general applications, mistakes in medical settings can have severe implications, making it crucial often struggle with hallucinations, misinterpretations, or outdated knowledge, which limits their reliability in high-stakes medical environments. This paper addresses the research gap by exploring techniques to enhance the reliability and performance of LLMs in biomedical applications, evaluating BioMedGPT, BioMedicine and BioMistral on PubMedQA and BioASQ datasets. To mitigate hallucinations and improve reliability, we applied a Retrieval-Augmented Generation (RAG) approach, achieving modest improvements. To overcome RAG’s limitations, we further explored a Graph RAG method using the Hetionet knowledge graph for better factual grounding. The results of this paper show promising results to advance the state of art in the biomedical domain. By using techniques like RAG and Graph RAG, we have addressed challenges related to accuracy and contextual relevance. With continued refinement, these models hold significant potential to enhance healthcare applications offering reliable, dependable and precise support for both clinicians and patients.},
booktitle = {Proceedings of the 2025 8th Artificial Intelligence and Cloud Computing Conference},
pages = {151–157},
numpages = {7},
keywords = {RAG, Graph RAG, Question Answering},
location = {Tokyo, Japan},
series = {AICCC '25}
}

