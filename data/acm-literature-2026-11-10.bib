@inproceedings{10.1145/3789418.3789428,
author = {Yang, Jiang and Qi, Yao and Yang, Wentao and Jiang, Ting and Song, Ziqi},
title = {Domain-Specific Knowledge Graph Construction via Reinforcement Learning-Augmented Large Language Models},
year = {2026},
isbn = {9798400719615},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3789418.3789428},
doi = {10.1145/3789418.3789428},
abstract = {Although the integration of large language models (LLMs) has significantly advanced knowledge graph (KG) construction, key challenges persist in their application to specific domains, including domain misalignment, hallucination-induced errors, and the constraints of static methods such as limited context windows and incomplete schemas. This study introduces a reinforcement learning (RL)-augmented LLM framework designed for domain-specific KG construction, which unifies LLM-based extraction with RL-driven adaptive optimization. We propose a group relative policy optimization (GRPO) method that integrates generative extraction with adaptive reward shaping, utilizing a curated geoscience KG as reference supervision to provide rewards for factual accuracy, conciseness, and structural validity. Experiments conducted on a sedimentary rock KG demonstrate that the RL-augmented model outperforms both general-purpose and domain-specific baselines by reducing hallucinations and enhancing ontology alignment. Furthermore, the framework attains comparable performance on general knowledge graph benchmarks, demonstrating its cross-domain robustness. These findings suggest that RL is a promising strategy for scalable, reliable, and domain-sensitive KG construction.},
booktitle = {Proceedings of the 9th International Conference on Algorithms, Computing and Systems},
pages = {79–85},
numpages = {7},
keywords = {Domain-specific knowledge representation, Reinforcement Learning},
location = {Bangkok, Thailand},
series = {ICACS '25}
}

@inproceedings{10.1145/3813723.3813728,
author = {Wang, Yi and Hu, Yang and Nie, Jiajun},
title = {Knowledge Graph-based Chain-of-thought Reasoning Framework for Complex Questions},
year = {2026},
isbn = {9798400725081},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3813723.3813728},
doi = {10.1145/3813723.3813728},
abstract = {Large language models (LLMs) are facing three major challenges in knowledge-intensive complex reasoning: traditional methods lead to knowledge fragmentation, the reasoning process lacks verifiable external knowledge anchors, and multi-hop reasoning paths are inconsistent. To solve the issues, this work proposes the knowledge graph-based chain-of-thought reasoning framework for complex questions (KGR-CoT). The framework is implemented through three core modules: First, the entity recognition and intent parsing module links entities in the user's question to the knowledge graph and parses the query intent. Second, targeting different scenarios, it employs multiple decomposition strategies such as graph traversal, betweenness centrality, or templating to break down complex reasoning tasks into some simple intermediate steps, achieving a transformation from implicit reasoning to explicit knowledge-guided reasoning. Finally, a feedback optimization mechanism is established, utilizing user interaction data to continuously improve system performance. Experimental results on benchmark datasets such as WebQSP and CompWebQ demonstrate that this framework significantly improves question-answering accuracy, particularly excelling on multi-step reasoning questions, while effectively reducing the hallucination phenomenon and strengthening the reasoning skills of the model.CCS CONCEPTS • Computing methodologies→Artificial intelligence},
booktitle = {Proceedings of the International Conference on Artificial Intelligence and Advanced Autonomous Systems},
pages = {47–54},
numpages = {8},
keywords = {Knowledge graph, chain-of-thought, graph reasoning},
location = {Linzhi, China},
series = {AIAAS '26}
}

@article{10.1145/3787466,
author = {Cui, Shuting and Sun, Ying and Zhang, Yuting and Meng, Qingxin and Zhu, Hengshu},
title = {LLM-enhanced Career Knowledge Graph Understanding for Job Mobility Prediction},
year = {2026},
issue_date = {September 2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
volume = {17},
number = {3},
issn = {2158-656X},
url = {https://doi.org/10.1145/3787466},
doi = {10.1145/3787466},
abstract = {Job mobility prediction is an emerging field with significant benefits for organizations and individuals, including enhanced job recommendations and career planning. Existing approaches leveraging textual information primarily rely on traditional neural network embedding methods, which are limited in capturing relationships between job-related entities at the semantic level. While Large Language Models (LLMs) offer greater potential by utilizing extensive background knowledge to better understand latent patterns in career trajectories, pure LLMs often struggle with hallucination issues due to insufficient domain-specific knowledge. To bridge this gap, we propose a knowledge graph-enhanced LLM framework, Smart Career Predictor (SCP). Our approach introduces three key innovations: (1) a job-related sub-knowledge graph retrieval mechanism to retain the most relevant job transition patterns, addressing the hallucination problem by providing enriched background knowledge; (2) an entropy-based retrieval score to alleviate graph imbalance issues by ensuring a more equitable representation of career entities; and (3) a multi-modal adapter to effectively integrate textual and graph-based information, enabling more accurate and context-aware job mobility predictions. Experimental results on two real-world career datasets show that our model significantly outperforms state-of-the-art baselines in next career hop prediction. The code for this article is available at .},
journal = {ACM Trans. Manage. Inf. Syst.},
month = sep,
articleno = {15},
numpages = {21},
keywords = {Job mobility prediction, knowledge graph, LLM}
}

@inproceedings{10.1007/978-3-032-32115-2_36,
author = {Cheng, Shu-Chen and Yang, Ming},
title = {A Multi-Agent System Framework for Structural Reconstruction and Evidence-Based Verification of Academic Literature},
year = {2026},
isbn = {978-3-032-32114-5},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-3-032-32115-2_36},
doi = {10.1007/978-3-032-32115-2_36},
abstract = {With the proliferation of digital academic literature, traditional Retrieval-Augmented Generation frameworks struggle with semantic fragmentation and logical hallucinations when processing complex PDF formats. This study proposes a Multi-Agent System based framework for document structuring and verification. Centrally managed by an Orchestrator Agent, the system adopts a “reconstruct-then-extract” strategy: the Sections Agent restores cross-page semantic flow and filters pseudo-headings, while the Structure Agent transforms figures and abstracts into structured metadata to prevent token overflow. For evaluation, we implemented an LLM-as-a-judge framework, inspired by MT-Bench and Chatbot Arena, to construct a dual-layer benchmark consisting of 100 retrieval queries and 30 response queries. Systematic experiments were conducted on chunking granularity, Knowledge Graph augmentation, and reasoning mechanisms (Think Mode). The results indicate that Knowledge Graph integration introduces semantic noise in localized datasets, leading to performance degradation. In contrast, the configuration using Chunk 1000 combined with Think Mode achieved a peak accuracy of 0.7667. These findings demonstrate that the proposed framework significantly enhances the traceability and accuracy of academic argumentation, providing a robust technical solution for personalized research assistants.},
booktitle = {Innovative Technologies and Learning: 9th International Conference, ICITL 2026, Ljubljana, Slovenia, August 4–6, 2026, Proceedings, Part II},
pages = {370–380},
numpages = {11},
keywords = {Multi-Agent System, Retrieval-Augmented Generation, Document Structure Reconstruction}
}

@inproceedings{10.1145/3820664.3820702,
author = {Wang, Xian-Fang and Ren, Hao and Wang, Xiao-Lei and Han, Zi-Rui and Qin, Pei-Wu},
title = {GraphRAG-TCM: A Hybrid Retrieval-Augmented Generation System for Traditional Chinese Medicine Clinical Decision Support},
year = {2026},
isbn = {9798400722653},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3820664.3820702},
doi = {10.1145/3820664.3820702},
abstract = {Traditional Chinese Medicine (TCM) relies on intricate knowledge systems encompassing syndromes, herbs, formulas, and symptoms. Large Language Models (LLMs) show potential in medical question answering but often produce inaccurate information and struggle with domain-specific reasoning. This paper introduces GraphRAG-TCM, a combined Retrieval-Augmented Generation (RAG) approach merging dense vector retrieval and knowledge graph exploration. We built a TCM knowledge graph with 112,751 nodes and 95,619 relationships across seven entity categories: Disease, Formula, Herb, Ingredient, Symptom, Syndrome, and Target. Our hybrid retrieval combines FAISS, BM25, and Neo4j graph traversal via Reciprocal Rank Fusion (RRF), with dictionary-based entity recognition and rule-based intent classification. We assess the system using Key-Fact F1 and Hallucination Rate (HR) metrics, avoiding biases from LLM-based judging. On 50 annotated TCM test cases, our system attains a Key-Fact F1 of 0.835 and a hallucination rate of 0.15%, surpassing both pure LLM and standard RAG baselines.},
booktitle = {Proceedings of the 2026 2nd International Symposium on Bioinformatics and Computational Biology},
pages = {242–246},
numpages = {5},
keywords = {Clinical Decision Support, GraphRAG, Hallucination Mitigation, Hybrid Retrieval, Knowledge Graph, Large Language Models, Retrieval-Augmented Generation, Traditional Chinese Medicine},
location = {Zhengzhou, China},
series = {ISBCB '26}
}

@inproceedings{10.1145/3841358.3841403,
author = {Xu, Zongyi and Meng, Shaochen and Zhang, Shuo and Li, Qianxi and Zhuang, Yuan},
title = {SKG4SCRepair:Skill Knowledge Graph-Guided Multi-Agent Repair for Smart Contract Vulnerabilities},
year = {2026},
isbn = {9798400724688},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3841358.3841403},
doi = {10.1145/3841358.3841403},
abstract = {Abstract. Smart contracts are programmable protocols deployed on the Ethereum blockchain platform and widely used in decentralized finance. However, they are immutable once deployed, making hidden security vulnerabilities a major risk leading to significant financial losses. Thus, detecting and automatically fixing these vulnerabilities have become critical. Existing methods primarily rely on template-based strategies, heuristic search, and deep learning, suffering from limited expert rules and weak generalization capabilities. Recent studies based on large language models (LLM) have demonstrated powerful capabilities in code understanding and generation, but suffer from insufficient context and hallucinations when fixing complex bugs. To address these challenges, we propose SKG4SCRepair, a smart contract vulnerability repair framework that combines a skill knowledge graph with multi-agent collaboration. It first extracts expert knowledge (i.e., vulnerability causes and repair strategies) from historical audit reports and standardizes it into skill units. These skills are then used to construct a knowledge graph that links vulnerability types with repair solutions. Finally, it employs a two-stage multi-agent workflow for vulnerability detection, repair planning, and validation. Experimental results demonstrate that SKG4SCRepair outperforms baseline models in both vulnerability detection and patch generation.},
booktitle = {Proceedings of the 9th International Conference on Machine Learning and Machine Intelligence},
pages = {324–330},
numpages = {7},
keywords = {Large Language Models, Smart Contract, Vulnerability Fixes},
location = {Tokyo, Japan},
series = {MLMI '26}
}

@inproceedings{10.1145/3650400.3650405,
author = {Wang, Chen and Hua, Min and Song, Jiale and Tang, Xue-song},
title = {Knowledge Graphs Enhanced Large Language Model Prompt for Electric Power Question Answering},
year = {2024},
isbn = {9798400708305},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3650400.3650405},
doi = {10.1145/3650400.3650405},
abstract = {With the continuous development and digital transformation in the field of electric power, the application of large language models in the electric power industry has become a remarkable trend. The electric power industry is an information-intensive domain involving extensive data processing, predictive analysis, and decision-making. Therefore, the application of large language models in the electric power sector is of great significance. Current large language models such as GPT3.5 and GLM can perform well in tasks such as question answering dialogues. However, these models still face challenges such as answer hallucination and inaccurate responses. This paper proposes a method to enhance question answering in large language models using knowledge graphs, aiming to improve the accuracy and reliability of these models in question answering tasks in the electric power domain.The proposed method first utilizes local electric power data to extract triplets and generate a question answering dataset specific to the electric power domain using a large language model. Then, the relationships of the knowledge graph triplets are incorporated into the question prompt to enhance the quality of the model's answers. Furthermore, we fine-tune the large language model using the expanded question set derived from the triplets as knowledge enhanced data. Subsequently, we conduct experiments on both an electric power question answering dataset and a knowledge graph question answering dataset. The experimental results demonstrate that our method significantly improves various metrics of the large language model in the electric power question answering task. This research provides new insights and approaches to enhance the effectiveness of question answering systems in the electric power domain. Future studies can further explore and optimize this prompt expansion method for application in broader domains and tasks.},
booktitle = {Proceedings of the 2023 7th International Conference on Electronic Information Technology and Computer Engineering},
pages = {24–29},
numpages = {6},
location = {Xiamen, China},
series = {EITCE '23}
}

@inproceedings{10.1145/3829441.3829453,
author = {Ma, Jiangtao and Zhang, Liufu},
title = {MCFS: LLM Reasoning Method Based on Multi-Level Constraints and Multi-Source Fusion Beam Search},
year = {2026},
isbn = {9798400724657},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3829441.3829453},
doi = {10.1145/3829441.3829453},
abstract = {Large Language Models (LLMs) have exhibited strong capabilities in language understanding and generation for open-domain question answering. However, they still suffer from widespread knowledge scarcity and hallucination issues in multi-hop factual reasoning scenarios, which affect the accuracy of reasoning results. The Knowledge Graph Retrieval-Augmented Generation (KG-RAG) paradigm can effectively make up for this defect and improve the reliability and interpretability of generated answers. Nevertheless, existing KG-RAG methods have obvious limitations: they either ignore the importance of graph structural information or neglect the relevance between relations and question semantics, ultimately restricting the accuracy of multi-hop reasoning. To overcome these limitations, this paper introduces MCFS, an LLM reasoning method that integrates multi-level constraints with multi-source fusion beam search, whose core goal is to achieve effective alignment among question semantics, LLM prior knowledge, and graph structural information. Specifically, first, we innovatively propose to generate multi-level constraints based on LLMs, providing precise guidance by extracting semantic constraints from questions; second, we train a semantically guided edge-level graph neural network (GNN) to model relation relevance; then, we innovatively propose a multi-source fusion beam search strategy to explore reliable reasoning paths; finally, we leverage explicit reasoning paths to guide LLMs in generating interpretable answers. Experimental results on standard knowledge graph question answering benchmarks show that MCFS consistently outperforms strong baselines and delivers the best overall performance.},
booktitle = {Proceedings of the 2026 3rd International Conference on Machine Learning and Intelligent Computing},
pages = {87–98},
numpages = {12},
keywords = {Large Language Model, Knowledge Graph, Multi-Level Constraints, Multi-source Fusion},
location = {Zhengzhou, China},
series = {MLIC '26}
}

@inproceedings{10.1145/3833541.3833649,
author = {Mi, Xingfeng and Zhang, Wei and Zhang, Xudong and Huang, Shanshan},
title = {An Intelligent Data Analysis Method and System Fusing Chat BI and Headless BI},
year = {2026},
isbn = {9798400722646},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3833541.3833649},
doi = {10.1145/3833541.3833649},
abstract = {In enterprise digital data analysis, standalone Chat BI and Headless BI have inherent technical flaws that make it hard to balance human-computer interaction convenience and analytical professionalism. This paper proposes a fused intelligent data analysis method and system with a generalized semantic layer-LLM dual-core architecture, integrating knowledge graph enhancement, table association weight modeling and scene adaptation mapping for end-to-end natural language-to-standardized query processing. It reuses Headless BI's semantic layer to build an enterprise unified semantic model and table association knowledge graph, parses natural language via LLM to generate semantic SQL, and proceeds with verification, authority injection, physical SQL conversion, and multi-modal display/analysis. A six-module supporting system is designed. Enterprise scenario experiments show the scheme boosts SQL generation accuracy by 15% vs pure LLM Chat BI, reaching over 90% for simple queries and 80% for complex ones. It mitigates LLM hallucinations, adapts to multi-source heterogeneous databases, and has strong enterprise implementability, satisfying enterprise-wide efficient and accurate intelligent data analysis demands.},
booktitle = {Proceedings of the 2026 3rd International Conference on Digital Society and Artificial Intelligence},
pages = {647–651},
numpages = {5},
keywords = {Chat BI, Headless BI, intelligent data analysis, knowledge graph, large language model, semantic SQL},
location = {Wuhan, China},
series = {DSAI '26}
}

@inproceedings{10.1007/978-3-032-32643-0_16,
author = {Djebabria, Hiba and Sam, Yacine and Messai, Nizar},
title = {Towards Personalized Oncology Rehabilitation: A Hybrid LLM–Knowledge Graph Recommendation Approach},
year = {2026},
isbn = {978-3-032-32642-3},
publisher = {Springer-Verlag},
address = {Berlin, Heidelberg},
url = {https://doi.org/10.1007/978-3-032-32643-0_16},
doi = {10.1007/978-3-032-32643-0_16},
abstract = {Patients in oncology face challenges regarding their rehabilitation during and after the treatment. Development in the field of Clinical Decision Support Systems (CDSS) offer nowadays new opportunities to transform complex medical guidelines into personalized, and intuitive physical activity recommendations. In this paper, we present a hybrid neuro-symbolic approach that combines LLM-RAG with Knowledge Graph, to recommend adapted physical activity (APA) to patients in oncology. Our solution integrates a recommendation module that leverages a fine-tuned LLM algorithm for generating tailored APA recommendations using a Retrieval Augmented Generation (RAG) module, to ground the generation process in a clinical context, thereby mitigating the risk of LLM hallucination, and a Knowledge graph integrating the SNOMED-CT ontology to validate the LLM output. The framework is built in a modular way following Service Oriented Architectures (SOA) to allow multiple sources data integration, and was implemented in a mobile application prototype for validation. The recommendation process responds dynamically to patient data and context changes, demonstrating a workflow that continuously adapts to patient profiles, preferences, and other relevant information (This work is being carried out in the context of the regional project SQVALD: .).},
booktitle = {Foundations of Intelligent Systems: 28th International Symposium, ISMIS 2026, Lyon, France, July 22–24, 2026, Proceedings},
pages = {185–199},
numpages = {15},
keywords = {Large Language Models, Knowledge Graph, Oncology, Recommendation, Retrieval Augmented Generation}
}

@inproceedings{10.1145/3813822.3814011,
author = {Zhou, Sihua},
title = {Knowledge graph-guided retrieval-augmented generation for explainable supply chain resilience assessment},
year = {2026},
isbn = {9798400722578},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3813822.3814011},
doi = {10.1145/3813822.3814011},
abstract = {Assessing the resilience of large-scale supply chains is a mission-critical yet under-solved problem in operations management, where existing approaches suffer from three fundamental limitations: (1)&nbsp;rule-based scoring models such as AHP and SCOR rely on pre-defined rubrics that cannot absorb heterogeneous, unstructured disruption knowledge; (2)&nbsp;general-purpose large language models (LLMs) produce assessments unsupported by domain evidence, resulting in high hallucination rates that preclude deployment in high-stakes settings; and (3)&nbsp;current retrieval-augmented generation (RAG) pipelines decouple retrieval from inference, discarding the structural dependencies that govern supply chain risk propagation. To address these gaps, we propose KG-RAF (Knowledge Graph-guided Retrieval-Augmented Framework), which introduces three tightly integrated innovations: a typed supply chain knowledge graph encoding supplier, product, and risk-event entities with weighted relational edges; a two-stage KG-guided semantic retrieval module that fuses dense encoding with graph-neighbourhood re-ranking; and an uncertainty-aware inference engine that jointly optimises resilience scoring and evidence verification to suppress hallucinated outputs. Experiments across four industrial domains demonstrate that KG-RAF achieves a Pearson correlation of 0.921 with expert annotations, reduces RMSE by up to 51% over the strongest baseline, and sustains robust performance under knowledge-base noise, out-of-distribution inputs, adversarial perturbations, and real-world Black Swan disruption events.},
booktitle = {Proceedings of the 2026 7th International Conference on Computer Information and Big Data Applications},
pages = {1172–1177},
numpages = {6},
keywords = {supply chain resilience, retrieval-augmented generation, knowledge graph, large language models, risk assessment},
location = {Wuhan, China},
series = {CIBDA '26}
}

