@article{10.1145/3862591,
author = {Ma, Chuangtao and Chakrabarti, Sriom and Khan, Arijit and Moln{\'a}r, B{\'a}lint},
title = {Knowledge Graph-based Retrieval-Augmented Generation for Schema Matching},
year = {2026},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
issn = {1556-4681},
url = {https://doi.org/10.1145/3862591},
doi = {10.1145/3862591},
abstract = {Traditional similarity-based schema matching methods fail to resolve semantic ambiguities and conflicts in complex, domain-specific mappings due to a lack of commonsense and domain-specific knowledge. In parallel, large language models (LLMs) without sufficient background knowledge tend to hallucinate, further complicating schema matching. To overcome these limitations, we introduce KG-RAG4SM, a Knowledge Graph-based Retrieval-Augmented Generation for Schema Matching. This method integrates novel retrieval mechanisms, including LLM-based, vector-based, graph traversal-based, and hybrid techniques with advanced reranking schemes to extract the most relevant subgraphs from large external KGs. Our approach achieves superior results without requiring re-training, as evidenced by improvements of 39.79% in precision and 30.56% in F1 score over LLM-based state-of-the-art (SOTA) methods (e.g., Jellyfish-8B) on the MIMIC dataset, and enhancements of 69.20% in precision and 21.99% in F1 score over pre-trained language model (PLM)-based SOTA methods (e.g., SMAT) on the Synthea dataset. Additionally, KG-RAG4SM scales effectively across KGs from commonsense KGs to domain-specific ones, while its instruction-tuning knowledge exclusion component ensures truthful performance in end-to-end schema matching tasks despite the suboptimal relevance of KG context. Our empirical analysis and case studies from real-world scenarios show that the hallucination problem in LLMs for schema matching is well mitigated by our solution.},
note = {Just Accepted},
journal = {ACM Trans. Knowl. Discov. Data},
month = nov,
keywords = {Schema Matching, Knowledge Graph-based Retrieval, Graph RAG, Data Integration}
}

@inproceedings{10.1145/3773365.3773493,
author = {Gong, Qihang and Bai, Zengding and Gao, Xiangyu and Luo, Dong and Ai, Shuhui},
title = {Collaborative Enhancement Method of Knowledge Graph and Large Language Model for Dispatch of Government Citizen Hotline},
year = {2025},
isbn = {9798400718748},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3773365.3773493},
doi = {10.1145/3773365.3773493},
abstract = {Government citizen hotlines are essential for addressing diverse public inquiries, but conventional dispatch systems face challenges including inefficient knowledge extraction, limited integration of knowledge graph (KG) and large language model (LLM), and poor adaptation to domain-specific contexts. This study introduces a collaborative enhancement framework that synergizes KG and LLM to improve the accuracy and efficiency of hotline dispatch operations. The proposed method employs automated knowledge extraction through prompt engineering, robust multi-source validation and fusion techniques, and a bidirectional KG-LLM enhancement loop to ensure dynamic knowledge optimization. By incorporating multimodal data processing and a self-optimizing closed-loop mechanism, the framework enhances knowledge coverage, mitigates model hallucinations, and accelerates response times. Experimental results in real-world citizen hotline scenarios demonstrate significant improvements in dispatch accuracy and operational efficiency over baseline approaches, underscoring its transformative potential for intelligent government service delivery.},
booktitle = {Proceedings of the 2025 8th International Conference on Computer Information Science and Artificial Intelligence},
pages = {813–817},
numpages = {5},
keywords = {citizen hotline, collaborative optimization, knowledge extraction, knowledge graph, large language model},
location = {Wuhan, China},
series = {CISAI '25}
}

@inproceedings{10.1609/aaai.v40i18.38532,
author = {Li, Guoyi and Hu, Die and Li, Haozhe and Yao, Zhongjiang and Mi, Wei and Liu, Zongzhen and Zhang, Xiaodan and Lyu, Honglei},
title = {Knowledge-enhanced image captioning with adaptive graph-based multimodal alignment and LLM},
year = {2026},
isbn = {978-1-57735-906-7},
publisher = {AAAI Press},
url = {https://doi.org/10.1609/aaai.v40i18.38532},
doi = {10.1609/aaai.v40i18.38532},
abstract = {Image captioning is crucial for multimodal understanding, bridging visual content and natural language. Despite recent advancements in Large Multimodal Models (LMMs), when faced with unseen entities or scenes in the open world, even when attempting to leverage learned knowledge, models still struggle with vague and inaccurate descriptions, and may even generate knowledge hallucinations. A key reason is that the model fails to effectively integrate knowledge with visual information, limiting its understanding of visual content. Thus, we propose Adaptive Knowledge Graph-guided Multimodal Alignment (AKGMA) for image captioning, which enhances semantic understanding in open-world scenes through visual knowledge reasoning, reducing knowledge hallucinations and improving caption quality. It consist three key components: Entity-guided Knowledge Aligner (EKA), Adaptive Knowledge Graph Construction (AKGC), and Scene-Context Knowledge Adapter (SCKA). EKA connects visual entities to knowledge graphs, providing structured knowledge to a small language model, which interacts with a visual encoder to acquire visual knowledge. AKGC uses reinforcement learning to build image-relevant subgraphs to optimize knowledge prompts and improve knowledge hallucinations. SCKA leverages scene graph annotations to extract visual contextual knowledge and inject it into Large Language Models (LLMs), ensuring the generated descriptions are consistent with the image's details. Additionally, we introduce UniKnowCap, a new image knowledge description dataset spanning various open-world knowledge domains, designed to evaluate the knowledge accuracy and detail consistency of model-generated descriptions. Extensive experiments show our model outperforms baselines across multiple metrics.},
booktitle = {Proceedings of the Fortieth AAAI Conference on Artificial Intelligence and Thirty-Eighth Conference on Innovative Applications of Artificial Intelligence and Sixteenth Symposium on Educational Advances in Artificial Intelligence},
articleno = {1676},
numpages = {9},
series = {AAAI'26/IAAI'26/EAAI'26}
}

