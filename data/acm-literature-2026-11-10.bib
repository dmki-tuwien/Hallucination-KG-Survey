@inproceedings{10.1145/3746252.3760893,
author = {Zhang, Qingyu and Hu, Min and Fei, Wenlong and Yang, Jiaoyun and Li, Hongbo},
title = {SAKG: Structure-Aware Large Language Model Framework for Knowledge Graph Reasoning},
year = {2025},
isbn = {9798400720406},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3746252.3760893},
doi = {10.1145/3746252.3760893},
abstract = {Existing approaches to leveraging knowledge graphs in large language models often lack explicit structural modeling, which can lead to hallucinations and unstable reasoning over graph data. To address this, we propose SAKG, a structure-aware prompting framework designed to enhance the alignment between knowledge graph representations and language model inference. SAKG employs a hierarchical prompting strategy that integrates explicit task instructions, structural embeddings, and selectively filtered neighbor context. In particular, we introduce a progressive neighbor selection mechanism that combines relation co-occurrence statistics with embedding-based semantic similarity, ensuring that only informative and relevant neighbors are included in the prompt. This design enables the model to better capture relational semantics, structural dependencies, and contextual cues within the graph. Experimental results on multiple benchmarks demonstrate that SAKG consistently improves the effectiveness and factual consistency of knowledge graph reasoning with large language models.},
booktitle = {Proceedings of the 34th ACM International Conference on Information and Knowledge Management},
pages = {5495–5499},
numpages = {5},
keywords = {knowledge graph, large language models, neighbor context},
location = {Seoul, Republic of Korea},
series = {CIKM '25}
}

@inproceedings{10.1145/3845354.3845447,
author = {Sun, Li and Su, Tao and Li, Yuehui and Wang, Hui},
title = {DP-PathGen: Decoupled LLM-KG Fusion for Adaptive Learning Path Generation in a 12-Pattern Design Pattern Course Unit},
year = {2026},
isbn = {9798400723650},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3845354.3845447},
doi = {10.1145/3845354.3845447},
abstract = {Design pattern courses contain dense prerequisite dependencies, and a single uniform learning path leaves little room for those dependencies to be handled at the learner level. In classroom use, large language model (LLM)-based path generation also faces two practical problems: prerequisite-order hallucination and high latency when many students request paths at the same time. This paper presents DP-PathGen, a decoupled LLM-knowledge graph (LLM-KG) architecture for adaptive learning path generation in a 12-pattern design pattern course unit. A design pattern knowledge graph (DPKG) and instructor rules determine path topology locally through a hard prerequisite mask and multiplicative readiness scoring, while the LLM is used only for asynchronous explanation generation with a profile-band explanation cache. A hysteresis-based replanning rule further reduces unstable path changes caused by noisy mastery updates. The system was evaluated using 120 real learner profiles and a four-week two-arm classroom controlled study. Compared with an LLM-only baseline, DP-PathGen reduced observed prerequisite violations within the verified DPKG and implemented rules from 14.5% to 0%, improved path accuracy from 71.2% to 92.5%, and increased normalized learning gain from 0.48 to 0.61 (({mathrm{p}} &lt; 0.001 ), Cohen's ({mathrm{d}} = 0.62 )). Under 120 concurrent requests, DP-PathGen achieved a 95th-percentile (P95) structural-path latency of 0.11 s and a P95 asynchronous-explanation latency of 1.15 s, with average observed token use of 662 tokens/request under a 64.2% cache-hit rate. The results show that keeping structural path planning separate from LLM-based explanation is a practical way to make adaptive learning paths more reliable in the tested course-unit setting.},
booktitle = {Proceedings of the 3rd International Conference on Intelligent Education and Computer Technology},
pages = {565–570},
numpages = {6},
keywords = {adaptive learning path, design pattern, intelligent tutoring, knowledge graph, large language model, learner profiling},
location = {Changsha, China},
series = {IECT '26}
}

@inproceedings{10.1145/3845354.3845445,
author = {Su, Tao and Sun, Li and Wang, Hui and Li, Yuehui},
title = {Design and Implementation of a Multi-Agent Hybrid Expert System Architecture for Design Pattern Learning},
year = {2026},
isbn = {9798400723650},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3845354.3845445},
doi = {10.1145/3845354.3845445},
abstract = {Large language model (LLM) tutors can provide scalable support for computer science learning, but their deployment in confusion-prone software engineering topics remains limited by hallucination, weak pattern-boundary control, and shallow personalization. This paper presents MAHES, a multi-agent hybrid expert system architecture for design pattern learning. MAHES integrates role-specialized LLM agents, a design-pattern knowledge graph, an expert rule base, a safety reviewer, semantic caching, and an exponential-moving-average learner profile. Its core mechanism is a two-stage hybrid fusion operator: an intra-segment quality gate scores candidate agent outputs by semantic quality, knowledge-graph consistency, expert-rule compliance, and an independent hallucination-risk penalty; a cross-segment fusion operator then assembles validated segments under learner-profile and rubric constraints. MAHES was implemented as a five-layer web platform with asynchronous agent scheduling and semantic caching. In a four-week classroom deployment, the system processed 12,847 interaction requests from 90 active learner accounts and reached a 42.0% semantic-cache hit rate. Across 400 task logs per model, MAHES reduced hallucination from 11.4% under an LLM+RAG baseline to 4.2% and reduced design-pattern confusion errors from 18.2% to 3.8%. A controlled classroom study with 90 participants showed a significant post-test improvement over the RAG control group (81.4 vs.&nbsp;72.5, Welch's t=4.73, p&lt;0.001, Cohen's d=0.99). These results indicate that knowledge-constrained multi-agent reasoning can improve both reliability and learning effectiveness in design-pattern tutoring.},
booktitle = {Proceedings of the 3rd International Conference on Intelligent Education and Computer Technology},
pages = {552–557},
numpages = {6},
keywords = {design pattern learning, hybrid expert system, intelligent tutoring, knowledge graph, large language model, multi-agent system},
location = {Changsha, China},
series = {IECT '26}
}

